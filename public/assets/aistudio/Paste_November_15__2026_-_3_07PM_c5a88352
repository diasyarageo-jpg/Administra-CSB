7_funcoes,norm_car_mt,raw_car text,"CREATE OR REPLACE FUNCTION public.norm_car_mt(raw_car text)
 RETURNS text
 LANGUAGE sql
 IMMUTABLE
 SET search_path TO ''
AS $function$
  SELECT regexp_replace(
    regexp_replace(
      regexp_replace(upper(coalesce(raw_car, '')), '^CAR[[:space:]]*[-:]*[[:space:]]*', ''),
      '[^A-Z0-9/]', '', 'g'),
    '^MT(?=[0-9])', '');
$function$
"
