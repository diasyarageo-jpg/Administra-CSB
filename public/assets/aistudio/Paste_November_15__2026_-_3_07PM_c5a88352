7_funcoes,consultar_cruzamento_integrado,"p_cars text[], p_cpf_cnpj text","CREATE OR REPLACE FUNCTION public.consultar_cruzamento_integrado(p_cars text[] DEFAULT ARRAY[]::text[], p_cpf_cnpj text DEFAULT NULL::text)
 RETURNS jsonb
 LANGUAGE plpgsql
 STABLE
 SET search_path TO 'public'
AS $function$
DECLARE
  v_cars text[];
  v_doc text;
  v_result jsonb;
BEGIN
  IF NOT public.is_active_user() THEN
    RAISE EXCEPTION 'Acesso negado.';
  END IF;

  v_doc := public.norm_digits_only(p_cpf_cnpj);

  SELECT coalesce(array_agg(DISTINCT n), ARRAY[]::text[])
  INTO v_cars
  FROM (
    SELECT public.norm_car_mt(c) AS n
    FROM unnest(coalesce(p_cars, ARRAY[]::text[])) AS c
  ) s
  WHERE nullif(n, '') IS NOT NULL;

  SELECT coalesce(jsonb_agg(to_jsonb(vb)), '[]'::jsonb)
  INTO v_result
  FROM public.vw_barragens_integradas vb
  WHERE (cardinality(v_cars) > 0 AND vb.car_norm = ANY (v_cars))
     OR (v_doc IS NOT NULL
         AND public.norm_digits_only(vb.empreendedor_cpf_cnpj) = v_doc);

  RETURN jsonb_build_object('barragens', v_result);
END;
$function$
"
