3_views_ddl,vw_barragens_integradas,VIEW," SELECT b.id,
    b.nome,
    b.car,
    norm_car_mt(b.car) AS car_norm,
    b.uf,
    b.municipio,
    b.municipio_ibge,
    b.empreendimento,
    b.processo,
    b.snisb,
    b.curso_agua,
    b.latitude,
    b.longitude,
    b.altura,
    b.volume,
    NULLIF(btrim(b.dano_potencial), ''::text) AS dano_potencial,
    NULLIF(btrim(b.categoria_risco), ''::text) AS categoria_risco,
    ((NULLIF(btrim(b.dano_potencial), ''::text) IS NOT NULL) AND (btrim(b.dano_potencial) <> 'Não classificada'::text)) AS dpa_classificada,
    b.classificada_em,
    b.situacao,
    b.observacoes,
    b.empreendedor_id,
    e.nome AS empreendedor_nome,
    e.cpf_cnpj AS empreendedor_cpf_cnpj,
    COALESCE(( SELECT jsonb_agg(jsonb_build_object('rtId', COALESCE(r.id, v.rt_id), 'nome', COALESCE(r.nome, v.nome), 'art', v.art, 'conselho', v.conselho, 'processo', v.processo)) AS jsonb_agg
           FROM (responsaveis_tecnicos_barragens v
             LEFT JOIN rts r ON ((r.id = v.rt_id)))
          WHERE (v.barragem_id = b.id)), '[]'::jsonb) AS responsaveis_tecnicos,
    COALESCE(( SELECT jsonb_agg(jsonb_build_object('id', d.id, 'origem', d.origem_sistema, 'tipoCodigo', d.tipo_codigo, 'tipo', d.tipo_nome, 'titulo', d.titulo, 'dataEmissao', d.data_emissao, 'situacao', d.situacao, 'analistas', d.analistas_elaboradores) ORDER BY d.data_emissao DESC) AS jsonb_agg
           FROM documentos_catalogo d
          WHERE (d.barragem_id = b.id)), '[]'::jsonb) AS documentos,
    b.created_at,
    b.updated_at
   FROM (barragens b
     LEFT JOIN empreendedores e ON ((e.id = b.empreendedor_id)));"
3_views_ddl,vw_cruzamento_car_barragens,VIEW," SELECT car_norm,
    min(btrim(car)) AS car_exibicao,
    count(*) AS total_barragens,
    array_remove(array_agg(DISTINCT empreendedor_id), NULL::text) AS empreendedores_ids,
    jsonb_agg(jsonb_build_object('id', id, 'nome', nome, 'municipio', municipio, 'empreendimento', empreendimento, 'processo', processo, 'snisb', snisb, 'altura', altura, 'volume', volume, 'danoPotencial', dano_potencial, 'categoriaRisco', categoria_risco, 'situacao', situacao, 'responsaveisTecnicos', responsaveis_tecnicos, 'documentos', documentos)) AS barragens_do_car
   FROM vw_barragens_integradas vb
  WHERE (NULLIF(car_norm, ''::text) IS NOT NULL)
  GROUP BY car_norm;"
3_views_ddl,vw_empreendedores_barragens_rts,VIEW," SELECT e.id AS empreendedor_id,
    e.nome AS empreendedor_nome,
    e.cpf_cnpj,
    e.municipio AS empreendedor_municipio,
    e.uf AS empreendedor_uf,
    count(vb.id) AS total_barragens,
    array_remove(array_agg(DISTINCT NULLIF(btrim(vb.car), ''::text)), NULL::text) AS cars_mt,
    COALESCE(jsonb_agg(jsonb_build_object('id', vb.id, 'nome', vb.nome, 'car', vb.car, 'processo', vb.processo, 'snisb', vb.snisb, 'municipio', vb.municipio, 'altura', vb.altura, 'volume', vb.volume, 'danoPotencial', vb.dano_potencial, 'categoriaRisco', vb.categoria_risco, 'situacao', vb.situacao, 'responsaveisTecnicos', vb.responsaveis_tecnicos, 'documentos', vb.documentos)) FILTER (WHERE (vb.id IS NOT NULL)), '[]'::jsonb) AS barragens
   FROM (empreendedores e
     LEFT JOIN vw_barragens_integradas vb ON ((vb.empreendedor_id = e.id)))
  GROUP BY e.id, e.nome, e.cpf_cnpj, e.municipio, e.uf;"
