 RETURNS text
 LANGUAGE sql
 IMMUTABLE
 SET search_path TO ''
AS $function$
  SELECT nullif(regexp_replace(coalesce(raw_val, ''), '[^0-9]', '', 'g'), '');
$function$
"
7_funcoes,solicitar_novo_acesso,"p_nome text, p_matricula text, p_email text, p_login text, p_perfil_profissional text, p_setor text","CREATE OR REPLACE FUNCTION public.solicitar_novo_acesso(p_nome text, p_matricula text, p_email text, p_login text, p_perfil_profissional text, p_setor text)
 RETURNS jsonb
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO ''
AS $function$
DECLARE
  v_id text;
  v_situacao text;
  v_status text;
  v_auth_user_id uuid;
  v_matches integer;
  v_email text;
  v_login text;
BEGIN
  IF btrim(coalesce(p_nome, '')) = ''
     OR btrim(coalesce(p_matricula, '')) = ''
     OR btrim(coalesce(p_email, '')) = '' THEN
    RETURN jsonb_build_object(
      'success', false,
      'error', 'Nome, matrícula e e-mail são obrigatórios.'
    );
  END IF;

  v_email := lower(btrim(p_email));
  v_login := lower(coalesce(nullif(btrim(p_login), ''), split_part(v_email, '@', 1)));

  IF v_email !~ '^[^[:space:]@]+@[^[:space:]@]+\.[^[:space:]@]+$' THEN
    RETURN jsonb_build_object('success', false, 'error', 'E-mail inválido.');
  END IF;

  -- Serializa solicitações para o mesmo e-mail.
  PERFORM pg_catalog.pg_advisory_xact_lock(
    pg_catalog.hashtextextended(v_email, 0)
  );

  SELECT count(*)
  INTO v_matches
  FROM public.usuarios
  WHERE lower(email) = v_email;

  IF v_matches > 1 THEN
    RETURN jsonb_build_object(
      'success', false,
      'error', 'Há cadastros duplicados para este e-mail. Contate a administração.'
    );
  END IF;

  SELECT id, situacao, status, auth_user_id
  INTO v_id, v_situacao, v_status, v_auth_user_id
  FROM public.usuarios
  WHERE lower(email) = v_email
  LIMIT 1
  FOR UPDATE;

  IF v_id IS NOT NULL THEN
    IF v_auth_user_id IS NOT NULL
       OR v_situacao = 'Ativo'
       OR v_status = 'Ativo' THEN
      RETURN jsonb_build_object(
        'success', false,
        'error', 'Já existe um cadastro ativo ou vinculado a este e-mail.'
      );
    END IF;

    IF v_situacao <> 'Pendente' AND v_status <> 'Pendente' THEN
      RETURN jsonb_build_object(
        'success', false,
        'error', 'Já existe um cadastro para este e-mail. Contate a administração.'
      );
    END IF;

    UPDATE public.usuarios
    SET nome = btrim(p_nome),
        matricula = btrim(p_matricula),
        login = v_login,
        perfil_profissional = nullif(btrim(coalesce(p_perfil_profissional, '')), ''),
        setor = nullif(btrim(coalesce(p_setor, '')), ''),
        situacao = 'Pendente',
        status = 'Pendente',
        senha_provisoria_enc = NULL,
        updated_at = now()
    WHERE id = v_id;

    RETURN jsonb_build_object(
      'success', true,
      'message', 'Solicitação atualizada e enviada para análise dos administradores.'
    );
  END IF;

  INSERT INTO public.usuarios (
    id, nome, matricula, email, login, perfil_profissional, setor,
    papel, situacao, status, auth_user_id, senha_provisoria_enc,
    observacoes, created_at, updated_at
  )
  VALUES (
    'usr_' || replace(gen_random_uuid()::text, '-', ''),
    btrim(p_nome),
    btrim(p_matricula),
    v_email,
    v_login,
    nullif(btrim(coalesce(p_perfil_profissional, '')), ''),
    nullif(btrim(coalesce(p_setor, '')), ''),
    'Visualizador',
    'Pendente',
    'Pendente',
    NULL,
    NULL,
    'Solicitação de acesso enviada pela página de login.',
    now(),
    now()
  );

  RETURN jsonb_build_object(
    'success', true,
    'message', 'Solicitação enviada para análise dos administradores.'
  );
END;
$function$
"
7_funcoes,trg_stamp_audit_fields,,"CREATE OR REPLACE FUNCTION public.trg_stamp_audit_fields()
 RETURNS trigger
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO ''
AS $function$
BEGIN
  IF TG_OP = 'INSERT' THEN
    IF auth.uid() IS NOT NULL THEN
      NEW.created_by := auth.uid()::text;
      NEW.updated_by := auth.uid()::text;
    END IF;
    NEW.updated_at := now();
    RETURN NEW;
  END IF;

  NEW.created_by := OLD.created_by;
  IF auth.uid() IS NOT NULL THEN
    NEW.updated_by := auth.uid()::text;
  END IF;
  NEW.updated_at := now();
  RETURN NEW;
END;
$function$
"