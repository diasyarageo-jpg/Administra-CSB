7_funcoes,is_active_user,,"CREATE OR REPLACE FUNCTION public.is_active_user()
 RETURNS boolean
 LANGUAGE sql
 STABLE SECURITY DEFINER
 SET search_path TO ''
AS $function$
  SELECT EXISTS (
    SELECT 1
    FROM public.usuarios u
    WHERE u.auth_user_id = auth.uid()
      AND coalesce(nullif(u.situacao, ''), nullif(u.status, '')) = 'Ativo'
  );
$function$
"
