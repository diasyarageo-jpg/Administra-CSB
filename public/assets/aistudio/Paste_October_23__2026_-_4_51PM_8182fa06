];

function getProductivityPoints(record) {
  if (record.kind === "extra") {
    return record.extraStatus === "Aprovada"
      ? Number(record.approvedPoints || 0)
      : 0;
  }

  if (record.kind === "unscored") return 0;

  return Number(record.unitPoints || 0) * Math.max(1, Number(record.quantity || 1));
}

function productivityStatusBadge(record) {
  if (record.kind === "extra") {
    return record.extraStatus === "Aprovada"
      ? '<span class="badge green">Extra aprovada</span>'
      : record.extraStatus === "Não aprovada"
        ? '<span class="badge red">Extra não aprovada</span>'
        : '<span class="badge amber">Aguardando validação</span>';
  }

  if (record.kind === "unscored") {
    return '<span class="badge gray">Sem pontuação</span>';
  }

  return '<span class="badge blue">Produto SURH</span>';
}

function renderProductivity() {
  const records = db.produtividades || [];
  const totalPoints = records.reduce((sum, item) => sum + getProductivityPoints(item), 0);
  const pendingExtras = records.filter(item =>
    item.kind === "extra" && item.extraStatus === "Pendente"
  ).length;
  const checkedForOfficialSheet = records.filter(item => item.inOfficialSheet).length;

  return `
