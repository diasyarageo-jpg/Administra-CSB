function updateProductivityFields() {
  const kind = document.getElementById("productivity-kind")?.value;
  const show = (id, visible) => document.getElementById(id)?.classList.toggle("hidden", !visible);

  show("scored-product-field", kind === "scored");
  show("quantity-field", kind === "scored");
  show("unscored-product-field", kind === "unscored");
  show("unscored-description-field", kind === "unscored");
  show("extra-points-field", kind === "extra");
  show("extra-order-field", kind === "extra");
  show("extra-approval-field", kind === "extra");

  const productSelect = document.getElementById("productivity-product");
  const unscoredSelect = document.getElementById("unscored-type");
  if (productSelect) productSelect.required = kind === "scored";
  if (unscoredSelect) unscoredSelect.required = kind === "unscored";
}

function updateProductivityProductInfo() {
  const code = document.getElementById("productivity-product")?.value;
  const product = SURH_PRODUCTS.find(item => item.code === code);
  const info = document.getElementById("productivity-product-info");
  if (info) {
    info.textContent = product
      ? `Nível ${product.level} · ${product.points} ponto(s) por execução. Para Notificações, selecione 2.7 — Relatório de Vistoria Remota por imagem.`
      : "A pontuação é definida pelo Anexo I – SURH.";
  }
}

function updateUnscoredDescription() {
  const type = document.getElementById("unscored-type")?.value;
  const input = document.getElementById("unscored-description");
  if (!input) return;

  if (type === "Ofício") {
    input.value = input.value || "Ofício";
    input.required = false;
  } else if (type === "Outro") {
    input.required = true;
  } else {
    input.required = false;
  }
}

function saveProductivity(event, index) {
  event.preventDefault();
  const form = event.currentTarget;
  const values = new FormData(form);
  const kind = String(values.get("kind") || "scored");
  const serverName = String(values.get("serverName") || "").trim();
  const date = String(values.get("date") || "");
  const prior = index === null ? {} : db.produtividades[index];

  if (kind === "extra") {
    const requestedPoints = Number(values.get("requestedPoints") || 0);
    if (!values.get("extraOrder") || !values.get("extraApproval")) {
      showToast("Para atividade extra, informe a ordem de serviço e a aprovação prévia formal.");
      return;
    }
    if (!Number.isInteger(requestedPoints) || requestedPoints < 1 || requestedPoints > 8) {
      showToast("A atividade extra deve ser informada entre 1 e 8 pontos.");
      return;
    }
  }

  const product = SURH_PRODUCTS.find(item => item.code === String(values.get("productCode") || ""));
  if (kind === "scored" && !product) {
    showToast("Selecione um produto do Anexo I – SURH.");
    return;
  }

  const unscoredType = String(values.get("unscoredType") || "");
  const unscoredDescription = String(values.get("unscoredDescription") || "").trim();
  if (kind === "unscored" && unscoredType === "Outro" && !unscoredDescription) {
    showToast("Descreva a atividade sem pontuação.");
    return;
  }

  const record = {
    id: prior.id || crypto.randomUUID(),
    date,
    serverName,
    unit: String(values.get("unit") || "").trim(),
    kind,
    productCode: kind === "scored" ? product.code : kind === "extra" ? "ART. 8º" : "",
    productTitle: kind === "scored"
      ? product.title
      : kind === "extra"
        ? "Atividade extra de gestão — art. 8º"
        : unscoredType === "Ofício"
          ? "Ofício — atividade sem pontuação"
          : unscoredDescription,
    unitPoints: kind === "scored" ? product.points : 0,
    quantity: kind === "scored" ? Math.max(1, Number(values.get("quantity") || 1)) : 1,
    unscoredType: kind === "unscored" ? unscoredType : "",
    unscoredDescription: kind === "unscored" ? (unscoredDescription || unscoredType) : "",
    sourceType: String(values.get("sourceType") || "manual"),
    sourceName: String(values.get("sourceName") || "").trim(),
    processRef: String(values.get("processRef") || "").trim(),
    documentRef: String(values.get("documentRef") || "").trim(),
    description: String(values.get("description") || "").trim(),
    notes: String(values.get("notes") || "").trim(),
    requestedPoints: kind === "extra" ? Number(values.get("requestedPoints") || 0) : 0,
    approvedPoints: prior.approvedPoints || 0,
    extraOrder: kind === "extra" ? String(values.get("extraOrder") || "").trim() : "",
    extraApproval: kind === "extra" ? String(values.get("extraApproval") || "").trim() : "",
    extraStatus: kind === "extra" ? (prior.extraStatus || "Pendente") : "",
    coordinator: prior.coordinator || "",
    reviewedAt: prior.reviewedAt || "",
    inOfficialSheet: prior.inOfficialSheet || false,
    officialSheetAt: prior.officialSheetAt || "",
    createdAt: prior.createdAt || new Date().toISOString(),
    updatedAt: new Date().toISOString()
  };

  const duplicate = db.produtividades.some((item, itemIndex) =>
    itemIndex !== index &&
    item.serverName?.trim().toLowerCase() === serverName.toLowerCase() &&
    item.date === date &&
    item.productCode === record.productCode &&
    item.processRef?.trim().toLowerCase() === record.processRef.toLowerCase() &&
    item.documentRef?.trim().toLowerCase() === record.documentRef.toLowerCase()
  );

  if (duplicate && !confirm("Há um lançamento com o mesmo servidor, data, produto e referência. Deseja salvar mesmo assim?")) {
    return;
  }

  if (index === null) db.produtividades.unshift(record);
  else db.produtividades[index] = record;

  persistData();
  closeModal();
  renderView();
  showToast("Lançamento salvo neste navegador.");
}

function reviewExtraActivity(index, approve) {
  const record = db.produtividades[index];
  if (!record || record.kind !== "extra" || record.extraStatus !== "Pendente") return;

  const coordinator = prompt("Nome do coordenador responsável pela decisão:");
  if (!coordinator || !coordinator.trim()) {
    showToast("Informe quem registrou a decisão.");
    return;
  }

  if (approve) {
    const pointsInput = prompt(`Pontos a aprovar para ${record.serverName}, em ${formatDate(record.date)}. Máximo de 8 pontos por dia:`, String(record.requestedPoints));
    if (pointsInput === null) return;

    const approvedPoints = Number(pointsInput);
    if (!Number.isInteger(approvedPoints) || approvedPoints < 1 || approvedPoints > 8) {
      showToast("Informe uma pontuação inteira entre 1 e 8.");
      return;
    }

    const sameDayApproved = db.produtividades
      .filter((item, itemIndex) =>
        itemIndex !== index &&
        item.kind === "extra" &&
        item.extraStatus === "Aprovada" &&
        item.date === record.date &&
        item.serverName?.trim().toLowerCase() === record.serverName?.trim().toLowerCase()
      )
      .reduce((sum, item) => sum + Number(item.approvedPoints || 0), 0);

    if (sameDayApproved + approvedPoints > 8) {
      showToast(`O limite do art. 8º é 8 pontos por servidor/dia. Já há ${sameDayApproved} ponto(s) extra aprovado(s) nesta data.`);
      return;
    }

    record.approvedPoints = approvedPoints;
    record.extraStatus = "Aprovada";
  } else {
    record.approvedPoints = 0;
    record.extraStatus = "Não aprovada";
  }

  record.coordinator = coordinator.trim();
  record.reviewedAt = new Date().toISOString();
  record.updatedAt = new Date().toISOString();

  persistData();
  renderView();
  showToast(approve ? "Atividade extra validada." : "Atividade extra marcada como não aprovada.");
}

function toggleOfficialSheet(index, checked) {
  const record = db.produtividades[index];
  if (!record) return;

  record.inOfficialSheet = checked;
  record.officialSheetAt = checked ? new Date().toISOString() : "";
  record.updatedAt = new Date().toISOString();

  persistData();
  renderView();
}

function deleteProductivity(index) {
  if (!confirm("Excluir este lançamento de produtividade?")) return;
  db.produtividades.splice(index, 1);
  persistData();
  renderView();
  showToast("Lançamento excluído.");
}

function renderPortarias() {
  const records = db.portarias || [];
  const completed = records.filter(item =>
    item.secretarySigned && item.extractPublished && item.orderPublished
  ).length;
  const pending = records.length - completed;

  return `
    <div class="pagehead">
      <div>
        <div class="eyebrow">Tramitação administrativa</div>
        <h2>Portarias</h2>
        <p>Acompanhe os processos, a assinatura e as publicações das Portarias.</p>
      </div>
      <div class="actions">
        <button class="btn green" onclick="openPortariaModal()">＋ Novo trâmite</button>
      </div>
    </div>

    <div class="stats">
      <div class="stat">
        <div><div class="label">Total de trâmites</div><div class="value">${records.length}</div></div>
        <div class="stat-ico">▣</div>
      </div>
      <div class="stat">
        <div><div class="label">Pendentes</div><div class="value">${pending}</div></div>
        <div class="stat-ico">◷</div>
      </div>
      <div class="stat">
        <div><div class="label">Concluídos</div><div class="value">${completed}</div></div>
        <div class="stat-ico">✓</div>
      </div>
      <div class="stat">
        <div><div class="label">Rascunhos</div><div class="value">${records.filter(item => item.draft).length}</div></div>
        <div class="stat-ico">✎</div>
      </div>
    </div>

    <div class="panel">
      <div class="panel-head">
        <h3>Trâmites de Portarias</h3>
        <span class="badge gray">${records.length} registros</span>
      </div>
      <div class="toolbar">
        <div class="field-search">
          <span>⌕</span>
          <input class="input" id="portaria-search" placeholder="Buscar por processo, portaria ou observação..." oninput="filterPortariaRows()" />
        </div>
      </div>
      <div class="tablewrap">
        <table>
          <thead>
            <tr>
              <th>Processo</th>
              <th>Portaria</th>
              <th>Envio</th>
              <th>Etapas</th>
              <th>Situação</th>
              <th>Ações</th>
            </tr>
          </thead>
          <tbody id="portaria-rows">
            ${records.length ? records.map((record, index) => renderPortariaRow(record, index)).join("") : `
              <tr><td colspan="6">
                <div class="empty">
                  <div class="empty-icon">▣</div>
                  <b>Nenhum trâmite de Portaria</b>
                  <p>Os registros começam vazios. Use “Novo trâmite” para incluir um registro.</p>
                </div>
              </td></tr>`}
          </tbody>
        </table>
      </div>
    </div>`;
}

function renderPortariaRow(record, index) {
  const complete = record.secretarySigned && record.extractPublished && record.orderPublished;
  const status = record.draft ? "Rascunho" : complete ? "Concluído" : "Pendente";
  const statusClass = record.draft ? "gray" : complete ? "green" : "amber";
  const searchText = `${record.processNumber || ""} ${record.orderNumber || ""} ${record.notes || ""}`.toLowerCase();

  return `
    <tr data-portaria-search="${escapeHtml(searchText)}">
      <td class="td-main">${valueLabel(record.processNumber)}</td>
      <td class="td-main">${valueLabel(record.orderNumber)}</td>
      <td>${formatDate(record.sentDate)}</td>
      <td>
        <span class="badge ${record.secretarySigned ? "green" : "gray"}">Assinatura ${record.secretarySigned ? "✓" : "—"}</span>
        <span class="badge ${record.extractPublished ? "green" : "gray"}">Extrato ${record.extractPublished ? "✓" : "—"}</span>
        <span class="badge ${record.orderPublished ? "green" : "gray"}">Portaria ${record.orderPublished ? "✓" : "—"}</span>
      </td>
      <td><span class="badge ${statusClass}">${status}</span></td>
      <td>
        <div class="row-actions">
          <button class="iconbtn" onclick="openPortariaModal(${index})">Editar</button>
          <button class="iconbtn" onclick="deletePortaria(${index})">Excluir</button>
        </div>
      </td>
    </tr>`;
}

function filterPortariaRows() {
  const term = (document.getElementById("portaria-search")?.value || "").trim().toLowerCase();
  document.querySelectorAll("#portaria-rows tr[data-portaria-search]").forEach(row => {
    row.style.display = row.dataset.portariaSearch.includes(term) ? "" : "none";
  });
}

function openPortariaModal(index = null) {
  const record = index === null ? {} : { ...db.portarias[index] };

  document.getElementById("modalRoot").innerHTML = `
    <div class="modal-back" onclick="if(event.target===this)closeModal()">
      <form class="modal" onsubmit="savePortaria(event, ${index === null ? "null" : index})">
        <div class="modal-head">
          <h3>${index === null ? "Novo trâmite" : "Editar trâmite"} · Portaria</h3>
          <button type="button" class="modal-close" onclick="closeModal()">×</button>
        </div>
        <div class="modal-body">
          <div class="form-grid">
            <div class="form-field">
              <label>Número do processo</label>
              <input class="input" name="processNumber" required value="${escapeHtml(record.processNumber || "")}" />
            </div>
            <div class="form-field">
              <label>Número da Portaria</label>
              <input class="input" name="orderNumber" required value="${escapeHtml(record.orderNumber || "")}" />
            </div>
            <div class="form-field">
              <label>Data de envio</label>
              <input class="input" name="sentDate" type="date" required value="${escapeHtml(record.sentDate || new Date().toISOString().slice(0, 10))}" />
            </div>
            <div class="form-field">
              <label>Data de finalização</label>
              <input class="input" name="finalDate" type="date" value="${escapeHtml(record.finalDate || "")}" />
            </div>

            <div class="form-field full">
              <label>Etapas do trâmite</label>
              <label class="product-option">
                <input type="checkbox" name="secretarySigned" ${record.secretarySigned ? "checked" : ""} />
                Assinatura da Secretaria
              </label>
              <label class="product-option">
                <input type="checkbox" name="extractPublished" ${record.extractPublished ? "checked" : ""} />
                Extrato publicado
              </label>
              <label class="product-option">
                <input type="checkbox" name="orderPublished" ${record.orderPublished ? "checked" : ""} />
                Portaria publicada
              </label>
              <label class="product-option">
                <input type="checkbox" name="draft" ${record.draft ? "checked" : ""} />
                Manter como rascunho
              </label>
            </div>

            <div class="form-field full">
              <label>Observações internas</label>
              <textarea class="textarea" name="notes">${escapeHtml(record.notes || "")}</textarea>
            </div>
          </div>
        </div>
        <div class="modal-foot">
          <button type="button" class="btn light" onclick="closeModal()">Cancelar</button>
          <button type="submit" class="btn green">Salvar trâmite</button>
        </div>
      </form>
    </div>`;
}

function savePortaria(event, index) {
  event.preventDefault();
  const values = new FormData(event.currentTarget);
  const prior = index === null ? {} : db.portarias[index];

  const secretarySigned = values.get("secretarySigned") === "on";
  const extractPublished = values.get("extractPublished") === "on";
  const orderPublished = values.get("orderPublished") === "on";
  const complete = secretarySigned && extractPublished && orderPublished;

  const record = {
    id: prior.id || crypto.randomUUID(),
    processNumber: String(values.get("processNumber") || "").trim(),
    orderNumber: String(values.get("orderNumber") || "").trim(),
    sentDate: String(values.get("sentDate") || ""),
    finalDate: String(values.get("finalDate") || "") || (complete ? new Date().toISOString().slice(0, 10) : ""),
    secretarySigned,
    extractPublished,
    orderPublished,
    draft: values.get("draft") === "on",
    notes: String(values.get("notes") || "").trim(),
    createdAt: prior.createdAt || new Date().toISOString(),
    updatedAt: new Date().toISOString()
  };

  if (index === null) db.portarias.unshift(record);
  else db.portarias[index] = record;

  persistData();
  closeModal();
  renderView();
  showToast("Trâmite de Portaria salvo neste navegador.");
}

function deletePortaria(index) {
  if (!confirm("Excluir este trâmite de Portaria?")) return;
  db.portarias.splice(index, 1);
  persistData();
  renderView();
  showToast("Trâmite removido.");
}

renderView();