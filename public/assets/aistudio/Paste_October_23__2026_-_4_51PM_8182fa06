              <label>Origem do registro</label>
              <select class="select" name="sourceType">
                <option value="manual" ${!record.sourceType || record.sourceType === "manual" ? "selected" : ""}>Manual — atividade fora de sistema</option>
                <option value="system" ${record.sourceType === "system" ? "selected" : ""}>Registro realizado em sistema</option>
              </select>
            </div>

            <div class="form-field">
              <label>Sistema de origem, se aplicável</label>
              <input class="input" name="sourceName" value="${escapeHtml(record.sourceName || "")}" placeholder="Nome do sistema ou ferramenta" />
