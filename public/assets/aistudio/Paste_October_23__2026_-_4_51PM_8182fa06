                <option value="Outro" ${record.unscoredType === "Outro" ? "selected" : ""}>Outro produto/atividade sem pontuação</option>
              </select>
            </div>

            <div class="form-field full hidden" id="unscored-description-field">
              <label>Identificação da atividade sem pontuação</label>
              <input class="input" name="unscoredDescription" id="unscored-description"
