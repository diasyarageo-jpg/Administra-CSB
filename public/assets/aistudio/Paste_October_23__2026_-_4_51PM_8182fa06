function renderProductivityRow(record, index) {
  const details = [
    record.productCode ? `Código ${record.productCode}` : "",
    record.quantity && record.kind === "scored" ? `Quantidade: ${record.quantity}` : "",
    record.description || ""
  ].filter(Boolean).join(" · ");

  const refs = [
    record.sourceType === "manual" ? "Manual" : "Informado como registro de sistema",
    record.sourceName || "",
    record.processRef ? `Processo: ${record.processRef}` : "",
    record.documentRef ? `Documento: ${record.documentRef}` : ""
  ].filter(Boolean).join(" · ");

  const points = getProductivityPoints(record);
  const canApprove = record.kind === "extra" && record.extraStatus === "Pendente";

  return `
    <tr data-productivity-search="${escapeHtml(
      `${record.serverName || ""} ${record.productTitle || ""} ${record.productCode || ""} ${record.description || ""} ${record.processRef || ""} ${record.documentRef || ""}`.toLowerCase()
    )}">
      <td>
        <span class="td-main">${formatDate(record.date)}</span>
        <span class="td-sub">${valueLabel(record.serverName)}</span>
      </td>
      <td>
        <span class="td-main">${valueLabel(record.productTitle)}</span>
        <span class="td-sub">${escapeHtml(details)}</span>
      </td>
      <td style="white-space:normal;min-width:180px">
        <span class="micro">${escapeHtml(refs || "—")}</span>
        ${record.kind === "extra" ? `
          <span class="td-sub">Ordem de serviço: ${valueLabel(record.extraOrder)}</span>
          <span class="td-sub">Aprovação prévia: ${valueLabel(record.extraApproval)}</span>` : ""}
      </td>
      <td class="td-main">${points}</td>
      <td>
        ${productivityStatusBadge(record)}
        ${record.extraStatus === "Aprovada" && record.coordinator ? `<span class="td-sub">Validada por ${escapeHtml(record.coordinator)}</span>` : ""}
        ${record.extraStatus === "Não aprovada" && record.coordinator ? `<span class="td-sub">Decisão por ${escapeHtml(record.coordinator)}</span>` : ""}
      </td>
      <td>
        <label style="display:flex;align-items:center;gap:6px;font-size:10px;white-space:nowrap;cursor:pointer">
          <input type="checkbox" ${record.inOfficialSheet ? "checked" : ""}
            onchange="toggleOfficialSheet(${index}, this.checked)" />
          ${record.inOfficialSheet ? "Inserido" : "Pendente"}
        </label>
        ${record.officialSheetAt ? `<span class="td-sub">${formatDate(record.officialSheetAt.slice(0, 10))}</span>` : ""}
      </td>
      <td>
        <div class="row-actions">
          ${canApprove ? `<button class="iconbtn" onclick="reviewExtraActivity(${index}, true)">Validar</button>` : ""}
          ${canApprove ? `<button class="iconbtn" onclick="reviewExtraActivity(${index}, false)">Recusar</button>` : ""}
          <button class="iconbtn" onclick="openProductivityModal(${index})">Editar</button>
          <button class="iconbtn" onclick="deleteProductivity(${index})">Excluir</button>
        </div>
      </td>
    </tr>`;
}

function filterProductivityRows() {
  const term = (document.getElementById("productivity-search")?.value || "").trim().toLowerCase();
  document.querySelectorAll("#productivity-rows tr[data-productivity-search]").forEach(row => {
    row.style.display = row.dataset.productivitySearch.includes(term) ? "" : "none";
  });
}

