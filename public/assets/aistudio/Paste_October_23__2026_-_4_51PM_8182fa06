          </div>

          <div class="form-grid">
            <div class="form-field">
              <label>Tipo de lançamento</label>
              <select class="select" name="kind" id="productivity-kind" onchange="updateProductivityFields()">
                <option value="scored" ${selectedKind === "scored" ? "selected" : ""}>Produto pontuável — Anexo I SURH</option>
                <option value="unscored" ${selectedKind === "unscored" ? "selected" : ""}>Atividade realizada sem pontuação</option>
                <option value="extra" ${selectedKind === "extra" ? "selected" : ""}>Atividade extra de gestão — art. 8º</option>
              </select>
            </div>

            <div class="form-field">
              <label>Data de realização</label>
              <input class="input" name="date" type="date" required value="${escapeHtml(record.date || new Date().toISOString().slice(0, 10))}" />
            </div>

            <div class="form-field">
              <label>Servidor responsável</label>
              <input class="input" name="serverName" required value="${escapeHtml(record.serverName || "")}" placeholder="Nome do servidor" />
            </div>

            <div class="form-field">
              <label>Unidade / setor</label>
              <input class="input" name="unit" value="${escapeHtml(record.unit || "")}" placeholder="Unidade de lotação" />
