    <option value="${escapeHtml(product.code)}" ${record.productCode === product.code ? "selected" : ""}>
      ${escapeHtml(product.code)} · ${escapeHtml(product.title)} — ${product.points} pontos
    </option>`).join("");

  document.getElementById("modalRoot").innerHTML = `
    <div class="modal-back" onclick="if(event.target===this)closeModal()">
      <form class="modal" onsubmit="saveProductivity(event, ${index === null ? "null" : index})">
        <div class="modal-head">
          <h3>${index === null ? "Novo lançamento" : "Editar lançamento"} · Produtividade</h3>
