{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/car-sync",
      "schedule": "0 8 * * *"
    }
  ],
  "functions": {
    "api/*.ts": {
      "includeFiles": "{src/server/**,src/config/**}"
    }
  },
  "rewrites": [
    {
      "source": "/api/solicitacoes-vistoria",
      "destination": "/api/solicitacoesVistoria"
    },
    {
      "source": "/api/solicitacoes-vistoria/:id",
      "destination": "/api/solicitacoesVistoria?id=:id"
    },
    {
      "source": "/api/solicitacoes-vistoria/:id/:action",
      "destination": "/api/solicitacoesVistoria?id=:id&action=:action"
    },
    {
      "source": "/api/solicitacoesVistoria/:id",
      "destination": "/api/solicitacoesVistoria?id=:id"
    },
    {
      "source": "/api/solicitacoesVistoria/:id/:action",
      "destination": "/api/solicitacoesVistoria?id=:id&action=:action"
    },
    {
      "source": "/empreendedores",
      "destination": "/index.html"
    },
    {
      "source": "/barragens",
      "destination": "/index.html"
    },
    {
      "source": "/rts",
      "destination": "/index.html"
    },
    {
      "source": "/conciliacao",
      "destination": "/index.html"
    },
    {
      "source": "/revisoes",
      "destination": "/index.html"
    },
    {
      "source": "/produtividade",
      "destination": "/index.html"
    },
    {
      "source": "/portarias",
      "destination": "/index.html"
    },
    {
      "source": "/pendencias",
      "destination": "/index.html"
    },
    {
      "source": "/solicitacoes-vistoria",
      "destination": "/index.html"
    },
    {
      "source": "/documentos",
      "destination": "/index.html"
    },
    {
      "source": "/usuarios",
      "destination": "/index.html"
    },
    {
      "source": "/integracao",
      "destination": "/index.html"
    },
    {
      "source": "/referencias",
      "destination": "/index.html"
    }
  ]
}
